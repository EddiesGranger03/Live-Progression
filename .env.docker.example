# Tùy chọn: sao chép thành .env để tùy chỉnh Docker Compose.
# Không cần tạo .env nếu dùng cổng mặc định 8080 và chưa gửi email.
SOLO_PORT=8080
SOLO_PUBLIC_URL=http://localhost:8080
SOLO_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Solo Leveling <no-reply@example.com>
