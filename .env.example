# Copy thành .env nếu cần. start.ps1 đọc các biến SOLO_ và SMTP_.
SOLO_PUBLIC_URL=http://127.0.0.1:8000
SOLO_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:4200
